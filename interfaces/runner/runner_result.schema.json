{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "enum": [
        "ranking",
        "metrics"
      ]
    },
    "predictions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "method_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "protocol_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "split": {
            "type": "string"
          },
          "format": {
            "const": "ranking_npz_v1"
          },
          "path": {
            "type": "string"
          },
          "feature_count": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "identity": {
            "type": "object",
            "properties": {
              "protocol_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "query_set_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "candidate_set_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "protocol_sha256",
              "query_set_sha256",
              "candidate_set_sha256"
            ],
            "additionalProperties": false
          },
          "tags": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "method_id",
          "protocol_id",
          "split",
          "format",
          "path",
          "feature_count",
          "identity"
        ],
        "additionalProperties": false
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "method_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "protocol_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "split": {
            "type": "string"
          },
          "subgroup": {
            "enum": [
              "all",
              "repeat",
              "novel"
            ]
          },
          "metric": {
            "type": "string"
          },
          "weighting": {
            "enum": [
              "event",
              "user"
            ]
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "n_queries": {
            "type": "integer",
            "minimum": 0
          },
          "n_users": {
            "type": "integer",
            "minimum": 0
          },
          "query_set_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "candidate_set_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "method_id",
          "protocol_id",
          "split",
          "subgroup",
          "metric",
          "weighting",
          "value",
          "n_queries",
          "n_users",
          "query_set_sha256",
          "candidate_set_sha256"
        ],
        "additionalProperties": false
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "costs": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "checks": {
      "type": "object",
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "passed",
                  "failed",
                  "unverified"
                ]
              },
              "detail": {
                "type": "string"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "id",
              "status",
              "detail",
              "evidence"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "passed",
        "items"
      ],
      "additionalProperties": false
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "kind",
          "description"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "kind",
    "predictions",
    "metrics",
    "coverage",
    "costs",
    "checks",
    "limitations",
    "artifacts"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "ranking"
          }
        }
      },
      "then": {
        "properties": {
          "predictions": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchflow.local/v1/runner_result.json"
}
