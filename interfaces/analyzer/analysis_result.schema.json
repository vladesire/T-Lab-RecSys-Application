{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "analysis_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "run_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "manifest_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "phase": {
            "enum": [
              "fixture",
              "development",
              "final"
            ]
          },
          "origin": {
            "enum": [
              "fresh_execution",
              "reproduction",
              "legacy_import"
            ]
          }
        },
        "required": [
          "run_id",
          "manifest_sha256",
          "phase",
          "origin"
        ],
        "additionalProperties": false
      }
    },
    "phases": {
      "type": "array",
      "items": {
        "enum": [
          "fixture",
          "development",
          "final"
        ]
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "method_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "protocol_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "split": {
            "type": "string"
          },
          "subgroup": {
            "enum": [
              "all",
              "repeat",
              "novel"
            ]
          },
          "metric": {
            "type": "string"
          },
          "weighting": {
            "enum": [
              "event",
              "user"
            ]
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "n_queries": {
            "type": "integer",
            "minimum": 0
          },
          "n_users": {
            "type": "integer",
            "minimum": 0
          },
          "query_set_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "candidate_set_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "series_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          }
        },
        "required": [
          "method_id",
          "protocol_id",
          "split",
          "subgroup",
          "metric",
          "weighting",
          "value",
          "n_queries",
          "n_users",
          "query_set_sha256",
          "candidate_set_sha256",
          "series_id"
        ],
        "additionalProperties": false
      }
    },
    "comparisons": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "left": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "right": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "protocol_id": {
            "type": "string"
          },
          "split": {
            "type": "string"
          },
          "subgroup": {
            "type": "string"
          },
          "metric": {
            "type": "string"
          },
          "weighting": {
            "type": "string"
          },
          "estimate": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "ci_low": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "ci_high": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "n_queries": {
            "type": "integer",
            "minimum": 0
          },
          "n_users": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "enum": [
              "computed",
              "unavailable"
            ]
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "left",
          "right",
          "protocol_id",
          "split",
          "subgroup",
          "metric",
          "weighting",
          "estimate",
          "ci_low",
          "ci_high",
          "n_queries",
          "n_users",
          "status",
          "reason",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "costs": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "checks": {
      "type": "object",
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "passed",
                  "failed",
                  "unverified"
                ]
              },
              "detail": {
                "type": "string"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "id",
              "status",
              "detail",
              "evidence"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "passed",
        "items"
      ],
      "additionalProperties": false
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "analysis_id",
    "inputs",
    "phases",
    "metrics",
    "comparisons",
    "coverage",
    "costs",
    "checks",
    "limitations"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchflow.local/v1/analysis_result.json"
}
