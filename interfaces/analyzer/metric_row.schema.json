{
  "type": "object",
  "properties": {
    "method_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "protocol_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "split": {
      "type": "string"
    },
    "subgroup": {
      "enum": [
        "all",
        "repeat",
        "novel"
      ]
    },
    "metric": {
      "type": "string"
    },
    "weighting": {
      "enum": [
        "event",
        "user"
      ]
    },
    "value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "n_queries": {
      "type": "integer",
      "minimum": 0
    },
    "n_users": {
      "type": "integer",
      "minimum": 0
    },
    "query_set_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "candidate_set_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "method_id",
    "protocol_id",
    "split",
    "subgroup",
    "metric",
    "weighting",
    "value",
    "n_queries",
    "n_users",
    "query_set_sha256",
    "candidate_set_sha256"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchflow.local/v1/metric_row.json"
}
