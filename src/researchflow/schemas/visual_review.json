{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "reviewer": {
      "type": "string"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "pdf_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "outcome": {
      "const": "passed"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "reviewer",
    "recorded_at",
    "pdf_sha256",
    "outcome",
    "notes"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchflow.local/v1/visual_review.json"
}
