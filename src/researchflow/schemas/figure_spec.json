    },
    "order": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
      }
    },
    "title": {
      "type": "string"
    },
    "ylabel": {
      "type": "string"
