  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "analysis_alias": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "kind": {
      "enum": [
        "metric_bars",
        "comparison_intervals"
      ]
    },
    "filters": {
