{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "bundle_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "bundle_kind": {
      "const": "compiled"
    },
    "status": {
      "enum": [
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "path",
          "sha256",
          "size_bytes"
        ],
        "additionalProperties": false
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "snapshot_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "pdf_path": {
          "type": "string"
        },
        "pdf_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "toolchain": {
          "type": "object"
        },
        "checks": {
          "type": "object",
          "properties": {
            "passed": {
              "type": "boolean"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "status": {
                    "enum": [
                      "passed",
                      "failed",
                      "unverified"
                    ]
                  },
                  "detail": {
                    "type": "string"
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "id",
                  "status",
                  "detail",
                  "evidence"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "passed",
            "items"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "snapshot_sha256",
        "pdf_path",
        "pdf_sha256",
        "toolchain",
        "checks"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "bundle_id",
    "bundle_kind",
    "status",
    "created_at",
    "files",
    "metadata"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchflow.local/v1/compiled_manifest.json"
}
