{
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z]+$"
    },
    "analysis_alias": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "pointer": {
      "type": "string"
    },
    "digits": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "name",
    "analysis_alias",
    "pointer",
    "digits"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchflow.local/v1/number_spec.json"
}
