{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "analysis_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "engine": {
      "enum": [
        "ranking",
        "external"
      ]
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "series": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "run_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "prediction_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          }
        },
        "required": [
          "id",
          "run_id",
          "prediction_id"
        ],
        "additionalProperties": false
      }
    },
    "k": {
      "type": "integer",
      "minimum": 1
    },
    "comparisons": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "left": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "right": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "metric": {
            "enum": [
              "ndcg",
              "recall"
            ]
          },
          "weighting": {
            "enum": [
              "event",
              "user"
            ]
          },
          "subgroup": {
            "enum": [
              "all",
              "repeat",
              "novel"
            ]
          }
        },
        "required": [
          "id",
          "left",
          "right",
          "metric",
          "weighting",
          "subgroup"
        ],
        "additionalProperties": false
      }
    },
    "bootstrap": {
      "type": "object",
      "properties": {
        "replicates": {
          "type": "integer",
          "minimum": 1
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "confidence": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        }
      },
      "required": [
        "replicates",
        "seed",
        "confidence"
      ],
      "additionalProperties": false
    },
    "external": {
      "type": "object",
      "properties": {
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "code_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "command",
        "code_paths",
        "timeout_seconds"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "analysis_id",
    "engine",
    "inputs",
    "series",
    "k",
    "comparisons",
    "bootstrap"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "engine": {
            "const": "external"
          }
        }
      },
      "then": {
        "required": [
          "external"
        ]
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchflow.local/v1/analysis_config.json"
}
