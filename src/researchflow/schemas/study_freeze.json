{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "freeze_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "configs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "experiment_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "identity": {
            "type": "object",
            "properties": {
              "scientific_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "code_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "data_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "scientific_sha256",
              "code_sha256",
              "data_sha256"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "experiment_id",
          "identity"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "freeze_id",
    "created_at",
    "configs"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchflow.local/v1/study_freeze.json"
}
