{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "bundle_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "bundle_kind": {
      "const": "run"
    },
    "status": {
      "enum": [
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "path",
          "sha256",
          "size_bytes"
        ],
        "additionalProperties": false
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "experiment_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "branch_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "hypothesis_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          }
        },
        "phase": {
          "enum": [
            "fixture",
            "development",
            "final"
          ]
        },
        "origin": {
          "enum": [
            "fresh_execution",
            "reproduction",
            "legacy_import"
          ]
        },
        "identity": {
          "type": "object",
          "properties": {
            "scientific_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "code_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "data_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "scientific_sha256",
            "code_sha256",
            "data_sha256"
          ],
          "additionalProperties": false
        },
        "result_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        },
        "process_status": {
          "type": "string"
        },
        "source_lineage": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "required": [
        "experiment_id",
        "branch_id",
        "hypothesis_ids",
        "phase",
        "origin",
        "identity",
        "result_path",
        "started_at",
        "finished_at",
        "process_status",
        "source_lineage"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "bundle_id",
    "bundle_kind",
    "status",
    "created_at",
    "files",
    "metadata"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchflow.local/v1/run_manifest.json"
}
