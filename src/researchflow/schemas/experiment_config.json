{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "scientific": {
      "type": "object",
      "properties": {
        "experiment_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "branch_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "hypothesis_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          }
        },
        "phase": {
          "enum": [
            "fixture",
            "development",
            "final"
          ]
        },
        "runner_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "protocol": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object"
            }
          ]
        },
        "parameters": {
          "type": "object"
        }
      },
      "required": [
        "experiment_id",
        "branch_id",
        "hypothesis_ids",
        "phase",
        "runner_id",
        "protocol",
        "parameters"
      ],
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "properties": {
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "code_paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "data_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
              },
              "manifest": {
                "type": "string"
              },
              "local_path": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "id",
              "manifest",
              "local_path"
            ],
            "additionalProperties": false
          }
        },
        "research_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resources": {
          "type": "object",
          "properties": {
            "timeout_seconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "memory_limit_bytes": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "timeout_seconds",
            "memory_limit_bytes"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "command",
        "code_paths",
        "data_refs",
        "research_paths",
        "resources"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "scientific",
    "runtime"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchflow.local/v1/experiment_config.json"
}
